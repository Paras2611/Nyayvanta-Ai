# Nyayavanta Environment Configuration

# Project Name
PROJECT_NAME="Nyayavanta"

# Security & JWT Token Signing
SECRET_KEY="your-secure-jwt-secret-key-change-in-production"

# Database Configuration (SQLite default for zero-config; or PostgreSQL connection string)
DATABASE_URL="sqlite:///./nyayavanta.db"
# DATABASE_URL="postgresql://nyayavanta_user:password@localhost:5432/nyayavanta_db"

# Optional: Google Gemini API Key for dynamic grounded legal synthesis
# If left blank, Nyayavanta operates with verified statutory knowledge synthesis
GEMINI_API_KEY=""

# Local Ollama AI Pipeline Configuration (CPU-Friendly 8GB RAM Default)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3.5:0.8b"
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
OLLAMA_TEMPERATURE=0.1
OLLAMA_KEEP_ALIVE="5m"

# Host & Port Settings
API_PORT=8000
FRONTEND_PORT=3000
